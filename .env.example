# Copy to .env.local and fill in. Nothing here is a real credential.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# public by definition. Never put a secret behind that prefix.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security, so it must never be exposed to the
# browser. Without it, entitlement resolution deliberately fails closed to the
# teaser rather than serving full reports to everyone.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Load-bearing well beyond Stripe redirects: canonical tags, sitemap entries,
# magic-link auth and every emailed report link are built from it. Must be the
# origin that actually serves (production is the `www` host; the apex 308s to
# it) and must match a URL on the Supabase redirect allowlist, or sign-in
# silently redirects to localhost. Read by `src/lib/site.ts`. See README → Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SINGLE_REPORT=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# ---------------------------------------------------------------------------
# Email — required in production
# ---------------------------------------------------------------------------
# The one-time ($49) tier creates no account, so the emailed link is the only
# durable way a buyer reaches the report they paid for. Unset, purchases still
# complete but deliver nothing, and /purchase/recover cannot help either.
#
# EMAIL_FROM must be on a domain verified with the provider, or the mail is
# accepted and then filed as spam.
RESEND_API_KEY=
EMAIL_FROM="ViolationRadar <reports@yourdomain.com>"

# ---------------------------------------------------------------------------
# NYC Open Data
# ---------------------------------------------------------------------------
# Optional but strongly recommended in production — anonymous SODA requests are
# throttled aggressively, and each report is roughly six of them.
SOCRATA_APP_TOKEN=

# ---------------------------------------------------------------------------
# Observability — optional, but see docs/LAUNCH-CHECKLIST.md
# ---------------------------------------------------------------------------
# Errors are always written to stderr as structured JSON. Set this as well and
# they are also POSTed somewhere a human will see them (the payload is shaped
# to work as-is with a Slack incoming webhook).
ERROR_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Only for `npm run screenshots` when Chromium isn't on the default path.
CHROMIUM_PATH=
